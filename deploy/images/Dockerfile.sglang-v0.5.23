# MiniMax-H3 变体 · SGLang v0.5.23 —— FastH3-Omni-8-Step-V1 专用
#
# 为什么单独一个 tag：FastH3-Omni（Ref2VA 8-step PDD）的支持在 SGLang
# PR #45530（2026-10-22）落地，进了 v0.5.23（2026-11-02）；v0.5.22 没有。
# 产物：video-sglang:v0.5.23，供 deploy/fasth3-omni-8step-v1-sglang 使用。
FROM lmsysorg/sglang:v0.5.23

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

WORKDIR /sgl-workspace/sglang

RUN pip install -e "python[diffusion]"

RUN pip install \
    huggingface_hub \
    accelerate \
    hf_transfer

# 早失败：确认这版镜像注册了 FastH3-Omni（宽松匹配 repo id 片段，避免上游拆行/换后缀误判）
RUN grep -rq "FastH3-Omni-8-Step" python/sglang/multimodal_gen/configs/

RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# 构建：
#   docker build -f deploy/images/Dockerfile.sglang-v0.5.23 -t video-sglang:v0.5.23 deploy/images
