# MiniMax-H3 变体 · SGLang dev —— Pika-H3-Flex 专用
#
# 为什么用 dev 而不是定版 tag：Pika-H3-Flex 支持在 SGLang PR #47378
# （2026-10-31）落地，晚于 v0.5.23 的 release 分支切点，因此**任何已发布 tag
# （含 v0.5.23）都不含 Pika**，只在 main。等 v0.5.24 发布后应把 FROM 换成定版 tag。
# 产物：video-sglang:dev，供 deploy/pika-h3-flex 使用。
#
# ⚠️ 可复现性：`:dev` 是滚动 tag。要锁定，把 FROM 换成某个 nightly
#    （lmsysorg/sglang:nightly-dev-YYYYMMDD-<sha>，日期 ≥ 2026-11-01），
#    或在此处 git checkout 到含 #47378 的具体 commit 再 pip install。
FROM lmsysorg/sglang:dev

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV PIP_INDEX_URL=${PIP_INDEX_URL}

WORKDIR /sgl-workspace/sglang

RUN pip install -e "python[diffusion]"

RUN pip install \
    huggingface_hub \
    accelerate \
    hf_transfer

# 早失败：确认这份 dev 已注册 Pika-H3-Flex（含 #47378）；拉到的 dev 太旧会在此失败
RUN grep -rq "Pika-H3-Flex" python/sglang/multimodal_gen/configs/

RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*

# 构建：
#   docker build -f deploy/images/Dockerfile.sglang-dev -t video-sglang:dev deploy/images
